{
  "name": "@local/dsh-download-progress",
  "version": "0.1.0",
  "private": true,
  "description": "Frosted-glass download progress overlay for DeepSeek Harness (DSH)",
  "license": "MIT",
  "author": "Sama05",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sama05/dsh-download-progress.git"
  },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "progress"],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
