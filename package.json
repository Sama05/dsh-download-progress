{
  "name": "@local/dsh-download-progress",
  "version": "0.2.1",
  "private": true,
  "description": "Frosted-glass download progress overlay for DeepSeek Harness (DSH)",
  "license": "MIT",
  "author": "Sama05",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sama05/dsh-download-progress.git"
  },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "progress"],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0-rc.1"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "build:check": "node scripts/build-client.mjs --check",
    "prepublishOnly": "node scripts/build-client.mjs --check",
    "test": "node scripts/build-client.mjs --check && node contract.mjs && node script.test.mjs && node smoke-boot.mjs && node smoke.mjs && node smoke-host.mjs && node stress-host.mjs && node stress-round2.mjs && node stress-client.mjs",
    "contract": "node contract.mjs",
    "bench": "node bench.mjs"
  },
  "files": [
    "index.js",
    "utils.js",
    "detect.js",
    "detect/",
    "state.js",
    "state/",
    "script.js",
    "script/",
    "background.js",
    "background/",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CONTRACT.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
